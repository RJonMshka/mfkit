{
  "name": "mfkit",
  "version": "0.0.0",
  "private": true,
  "description": "Polyglot Module Federation, scaffolded and self-healing.",
  "license": "MIT",
  "author": "Rajat Kumar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RJonMshka/mfkit.git"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "biome check .",
    "pack-check": "node scripts/pack-check.mjs",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@changesets/cli": "^3.0.3",
    "@vitest/coverage-v8": "^3.2.7",
    "tsup": "^8.4.0",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  }
}

{
  "name": "@mfkit/kit",
  "version": "0.0.0",
  "description": "MFKit runtime — Vite config generation, lifecycle contract, self-healing primitives, <MFKitOutlet>.",
  "license": "MIT",
  "author": "Rajat Kumar",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./healing": {
      "types": "./dist/healing.d.ts",
      "import": "./dist/healing.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@mfkit/plugin-api": "workspace:*",
    "valibot": "^1.0.0"
  },
  "peerDependencies": {
    "@analogjs/vite-plugin-angular": ">=1.0.0",
    "@module-federation/vite": "^1.5.0",
    "@sveltejs/vite-plugin-svelte": ">=4.0.0",
    "@vitejs/plugin-react": ">=4.0.0",
    "@vitejs/plugin-vue": ">=5.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "vite": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "@analogjs/vite-plugin-angular": { "optional": true },
    "@module-federation/vite": { "optional": true },
    "@sveltejs/vite-plugin-svelte": { "optional": true },
    "@vitejs/plugin-react": { "optional": true },
    "@vitejs/plugin-vue": { "optional": true },
    "react": { "optional": true },
    "react-dom": { "optional": true },
    "vite": { "optional": true }
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^1.16.0",
    "@module-federation/vite": "^1.5.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "vite": "^6.0.0",
    "vitest": "^3.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}

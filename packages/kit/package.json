{
  "name": "@mfkit/kit",
  "version": "0.0.0",
  "description": "MFKit runtime — Vite config generation, lifecycle contract, self-healing primitives, <MFKitOutlet>.",
  "license": "MIT",
  "author": "Rajat Kumar",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./healing": {
      "types": "./dist/healing.d.ts",
      "import": "./dist/healing.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@mfkit/plugin-api": "workspace:*",
    "valibot": "^1.0.0"
  },
  "peerDependencies": {
    "@module-federation/vite": "^1.5.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "vite": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "@module-federation/vite": { "optional": true },
    "react": { "optional": true },
    "react-dom": { "optional": true },
    "vite": { "optional": true }
  },
  "devDependencies": {
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.5",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}

{
  "name": "@mfkit/plugin-api",
  "version": "0.0.0",
  "description": "Stable TypeScript contract surface for MFKit. Types only — zero runtime.",
  "license": "MIT",
  "author": "Rajat Kumar",
  "repository": {
    "type": "git",
    "url": "https://github.com/rajatkumar/mfkit.git",
    "directory": "packages/plugin-api"
  },
  "homepage": "https://github.com/rajatkumar/mfkit/tree/main/packages/plugin-api#readme",
  "bugs": "https://github.com/rajatkumar/mfkit/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}

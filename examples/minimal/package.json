{
  "name": "mfkit-example-minimal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter \"@mfkit-example/*\" dev",
    "gen": "tsx scripts/gen.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "e2e": "node scripts/e2e.mjs",
    "clean": "rm -rf .turbo"
  },
  "dependencies": {
    "@mfkit/kit": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "playwright-core": "^1.50.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3"
  }
}

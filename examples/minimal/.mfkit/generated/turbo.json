{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "coverage/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "clean": {
      "cache": false
    },
    "@mfkit-example/shell#dev": {
      "with": [
        "@mfkit-example/mfe-hello#dev",
        "@mfkit-example/mfe-clock#dev"
      ],
      "cache": false,
      "persistent": true
    }
  }
}
